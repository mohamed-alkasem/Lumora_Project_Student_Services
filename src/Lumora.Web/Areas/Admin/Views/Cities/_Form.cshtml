@model Lumora.Application.DTOs.Cities.CityCreateDto

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<partial name="_LangTabsHeader" model='"trx"' />
<div class="tab-content" id="trx-content">
    @for (var i = 0; i < Model.Translations.Count; i++)
    {
        var code = Model.Translations[i].LanguageCode;
        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="trx-@code" role="tabpanel"
             dir="@LanguageConstants.DirectionOf(code)">
            <input type="hidden" asp-for="Translations[i].LanguageCode" />
            <div class="mb-3">
                <label asp-for="Translations[i].Name" class="form-label">@SharedLocalizer["Name"] (@code.ToUpper())</label>
                <input asp-for="Translations[i].Name" class="form-control" />
                <span asp-validation-for="Translations[i].Name" class="text-danger small"></span>
            </div>
        </div>
    }
</div>
