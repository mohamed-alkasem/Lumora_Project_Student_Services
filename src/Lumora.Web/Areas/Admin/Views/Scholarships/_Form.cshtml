@model Lumora.Application.DTOs.Scholarships.ScholarshipCreateDto

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="UniversityId" class="form-label">@SharedLocalizer["University"]</label>
        <select asp-for="UniversityId" class="form-select" asp-items="@((List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Universities)"></select>
        <span asp-validation-for="UniversityId" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="OriginalPriceUsd" class="form-label">@SharedLocalizer["OriginalPriceLabel"] ($)</label>
        <input asp-for="OriginalPriceUsd" class="form-control" />
        <span asp-validation-for="OriginalPriceUsd" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="DiscountedPriceUsd" class="form-label">@SharedLocalizer["DiscountedPriceLabel"] ($)</label>
        <input asp-for="DiscountedPriceUsd" class="form-control" />
        <span asp-validation-for="DiscountedPriceUsd" class="text-danger small"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Deadline" class="form-label">@SharedLocalizer["DeadlineLabel"]</label>
        <input asp-for="Deadline" class="form-control" type="date" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="DisplayOrder" class="form-label">@SharedLocalizer["DisplayOrder"]</label>
        <input asp-for="DisplayOrder" class="form-control" />
    </div>
    <div class="col-md-3 mb-3">
        <label class="form-label" for="imageFile">@SharedLocalizer["ImageLabel"]</label>
        <input type="file" id="imageFile" name="imageFile" class="form-control" accept=".png,.jpg,.jpeg,.webp,.svg" />
        <input type="hidden" asp-for="ImageUrl" />
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img class="admin-form-image-preview" src="@Model.ImageUrl" alt="" />
        }
    </div>
    <div class="col-md-2 mb-3 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">@SharedLocalizer["Active"]</label>
        </div>
    </div>
</div>

<partial name="_LangTabsHeader" model='"trx"' />
<div class="tab-content" id="trx-content">
    @for (var i = 0; i < Model.Translations.Count; i++)
    {
        var code = Model.Translations[i].LanguageCode;
        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="trx-@code" role="tabpanel"
             dir="@LanguageConstants.DirectionOf(code)">
            <input type="hidden" asp-for="Translations[i].LanguageCode" />
            <div class="mb-3">
                <label asp-for="Translations[i].Title" class="form-label">@SharedLocalizer["TitleLabel"] (@code.ToUpper())</label>
                <input asp-for="Translations[i].Title" class="form-control" />
                <span asp-validation-for="Translations[i].Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Translations[i].Description" class="form-label">@SharedLocalizer["Description"] (@code.ToUpper())</label>
                <textarea asp-for="Translations[i].Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Translations[i].Description" class="text-danger small"></span>
            </div>
        </div>
    }
</div>
