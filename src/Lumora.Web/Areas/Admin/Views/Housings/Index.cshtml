@model IEnumerable<Lumora.Application.DTOs.Housings.HousingDetailsDto>
@{
    ViewData["Title"] = SharedLocalizer["Housing"].Value;
}

<div class="admin-toolbar">
    <span></span>
    <a class="btn lum-btn-navy" asp-action="Create">+ @SharedLocalizer["AddNew"]</a>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>@SharedLocalizer["ImageLabel"]</th>
                <th>@SharedLocalizer["TitleLabel"]</th>
                <th>@SharedLocalizer["CityLabel"]</th>
                <th>@SharedLocalizer["PricePerMonth"]</th>
                <th>@SharedLocalizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var housing in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(housing.ImageUrl))
                        {
                            <img class="admin-thumb" src="@housing.ImageUrl" alt="@housing.Title" />
                        }
                    </td>
                    <td>@housing.Title</td>
                    <td>@housing.CityName</td>
                    <td>$@housing.PricePerMonthUsd.ToString("N0")</td>
                    <td>
                        <div class="admin-actions">
                            <a class="btn btn-sm lum-btn-outline" asp-action="Edit" asp-route-id="@housing.Id">@SharedLocalizer["Edit"]</a>
                            <form asp-action="Delete" asp-route-id="@housing.Id" method="post"
                                  data-confirm="@SharedLocalizer["ConfirmDelete"]">
                                <button type="submit" class="btn btn-sm btn-outline-danger">@SharedLocalizer["Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
