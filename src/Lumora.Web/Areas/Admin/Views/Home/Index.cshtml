@model Lumora.Web.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = SharedLocalizer["Dashboard"].Value;
}

@* Row 1 — live activity (what needs the admin's attention today). *@
<h2 class="admin-dash-heading">@SharedLocalizer["NewConsultations"] &amp; @SharedLocalizer["Students"]</h2>
<div class="admin-stats admin-stats-primary">
    <a class="admin-stat-card @(Model.NewConsultations > 0 ? "is-alert" : "")"
       asp-controller="Consultations" asp-action="Index">
        <span class="admin-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"/></svg></span>
        <div>
            <div class="admin-stat-value" data-count="@Model.NewConsultations">@Model.NewConsultations</div>
            <div class="admin-stat-label">@SharedLocalizer["NewConsultations"]</div>
        </div>
    </a>
    <a class="admin-stat-card" asp-controller="Chat" asp-action="Index">
        <span class="admin-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM7 9h10v2H7zm0-3h10v2H7zm0 6h7v2H7z"/></svg></span>
        <div>
            <div class="admin-stat-value">→</div>
            <div class="admin-stat-label">@SharedLocalizer["MessagesLabel"]</div>
        </div>
    </a>
    <a class="admin-stat-card" asp-controller="Students" asp-action="Index">
        <span class="admin-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm-8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13zm8 0c-.29 0-.62.02-.97.05A4.22 4.22 0 0 1 17 16.5V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg></span>
        <div>
            <div class="admin-stat-value" data-count="@Model.Students">@Model.Students</div>
            <div class="admin-stat-label">@SharedLocalizer["Students"]</div>
        </div>
    </a>
</div>

@* Row 2 — site content counts. *@
<h2 class="admin-dash-heading">@SharedLocalizer["WhatWeOffer"]</h2>
<div class="admin-stats">
    <a class="admin-stat-card" asp-controller="Universities" asp-action="Index">
        <span class="admin-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3z"/></svg></span>
        <div>
            <div class="admin-stat-value" data-count="@Model.Universities">@Model.Universities</div>
            <div class="admin-stat-label">@SharedLocalizer["Universities"]</div>
        </div>
    </a>
    <a class="admin-stat-card" asp-controller="Housings" asp-action="Index">
        <span class="admin-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3 4 9v12h5v-7h6v7h5V9l-8-6z"/></svg></span>
        <div>
            <div class="admin-stat-value" data-count="@Model.Housings">@Model.Housings</div>
            <div class="admin-stat-label">@SharedLocalizer["Housing"]</div>
        </div>
    </a>
    <a class="admin-stat-card" asp-controller="Cities" asp-action="Index">
        <span class="admin-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5z"/></svg></span>
        <div>
            <div class="admin-stat-value" data-count="@Model.Cities">@Model.Cities</div>
            <div class="admin-stat-label">@SharedLocalizer["Cities"]</div>
        </div>
    </a>
    <a class="admin-stat-card" asp-controller="Programs" asp-action="Index">
        <span class="admin-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM9 4h2v5l-1-.75L9 9zm9 16H6V4h1v9l3-2.25L13 13V4h5z"/></svg></span>
        <div>
            <div class="admin-stat-value" data-count="@Model.Programs">@Model.Programs</div>
            <div class="admin-stat-label">@SharedLocalizer["Programs"]</div>
        </div>
    </a>
    <a class="admin-stat-card" asp-controller="Faqs" asp-action="Index">
        <span class="admin-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 17h-2v-2h2zm2.07-7.75-.9.92A3.4 3.4 0 0 0 13 14.5h-2v-.5a4.4 4.4 0 0 1 1.29-3.1l1.24-1.26A1.96 1.96 0 0 0 12 6a2 2 0 0 0-2 2H8a4 4 0 0 1 8 0 3.18 3.18 0 0 1-.93 2.25z"/></svg></span>
        <div>
            <div class="admin-stat-value" data-count="@Model.Faqs">@Model.Faqs</div>
            <div class="admin-stat-label">@SharedLocalizer["Faqs"]</div>
        </div>
    </a>
    <a class="admin-stat-card" asp-controller="Testimonials" asp-action="Index">
        <span class="admin-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 17h3l2-4V7H5v6h3l-2 4zm8 0h3l2-4V7h-6v6h3l-2 4z"/></svg></span>
        <div>
            <div class="admin-stat-value" data-count="@Model.Testimonials">@Model.Testimonials</div>
            <div class="admin-stat-label">@SharedLocalizer["Testimonials"]</div>
        </div>
    </a>
</div>
