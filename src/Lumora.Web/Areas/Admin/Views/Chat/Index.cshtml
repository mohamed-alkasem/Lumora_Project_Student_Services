@model IReadOnlyList<Lumora.Application.DTOs.Chat.ChatConversationDto>
@{
    ViewData["Title"] = SharedLocalizer["MessagesLabel"].Value;
    var names = (Dictionary<int, string>)ViewBag.StudentNames;
}

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>@SharedLocalizer["Students"]</th>
                <th>@SharedLocalizer["Message"]</th>
                <th>@SharedLocalizer["CreatedAt"]</th>
                <th></th>
                <th>@SharedLocalizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var conversation in Model)
            {
                <tr>
                    <td>@names[conversation.StudentUserId]</td>
                    <td class="text-truncate" style="max-inline-size: 28ch;">@conversation.LastMessagePreview</td>
                    <td>@conversation.LastMessageAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (conversation.UnreadFromStudent > 0)
                        {
                            <span class="admin-badge admin-badge-new">@conversation.UnreadFromStudent</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm lum-btn-navy" asp-action="Conversation" asp-route-id="@conversation.Id">
                            @SharedLocalizer["Open"]
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted mt-3">@SharedLocalizer["NoMessagesYet"]</p>
}
