@model Lumora.Application.DTOs.Faqs.FaqCreateDto

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3" style="max-inline-size: 12rem;">
    <label asp-for="DisplayOrder" class="form-label">@SharedLocalizer["DisplayOrder"]</label>
    <input asp-for="DisplayOrder" class="form-control" />
    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
</div>

<partial name="_LangTabsHeader" model='"trx"' />
<div class="tab-content" id="trx-content">
    @for (var i = 0; i < Model.Translations.Count; i++)
    {
        var code = Model.Translations[i].LanguageCode;
        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="trx-@code" role="tabpanel"
             dir="@LanguageConstants.DirectionOf(code)">
            <input type="hidden" asp-for="Translations[i].LanguageCode" />
            <div class="mb-3">
                <label asp-for="Translations[i].Question" class="form-label">@SharedLocalizer["Question"] (@code.ToUpper())</label>
                <input asp-for="Translations[i].Question" class="form-control" />
                <span asp-validation-for="Translations[i].Question" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Translations[i].Answer" class="form-label">@SharedLocalizer["Answer"] (@code.ToUpper())</label>
                <textarea asp-for="Translations[i].Answer" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Translations[i].Answer" class="text-danger small"></span>
            </div>
        </div>
    }
</div>
