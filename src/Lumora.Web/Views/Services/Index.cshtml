@{
    ViewData["Title"] = SharedLocalizer["Services"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/services.css" asp-append-version="true" />
}

<section class="svc-hero">
    <div class="container">
        <h1 class="svc-hero-title">@SharedLocalizer["Services"]</h1>
        <p class="svc-hero-subtitle">@SharedLocalizer["ServicesHeroSubtitle"]</p>
    </div>
    <div class="svc-hero-glow" aria-hidden="true"></div>
</section>

<section class="svc-content">
    <div class="container">
        <div class="svc-grid">
            <article class="svc-card">
                <span class="svc-icon svc-icon-navy">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3zm-7 9.18v4L12 20l7-3.82v-4L12 16l-7-3.82z"/></svg>
                </span>
                <h2 class="svc-title">@SharedLocalizer["ServiceAdmissionsTitle"]</h2>
                <p class="svc-text">@SharedLocalizer["ServiceAdmissionsText"]</p>
                <a class="svc-link" asp-controller="Universities" asp-action="Index">@SharedLocalizer["BrowseUniversities"]</a>
            </article>

            <article class="svc-card">
                <span class="svc-icon svc-icon-gold">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3 4 9v12h5v-7h6v7h5V9l-8-6z"/></svg>
                </span>
                <h2 class="svc-title">@SharedLocalizer["ServiceHousingTitle"]</h2>
                <p class="svc-text">@SharedLocalizer["ServiceHousingText"]</p>
                <a class="svc-link" asp-controller="Housings" asp-action="Index">@SharedLocalizer["Housing"]</a>
            </article>

            <article class="svc-card">
                <span class="svc-icon svc-icon-navy">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zm-2 10H6v-2h12v2zm0-4H6V6h12v2z"/></svg>
                </span>
                <h2 class="svc-title">@SharedLocalizer["ServiceConsultingTitle"]</h2>
                <p class="svc-text">@SharedLocalizer["ServiceConsultingText"]</p>
                <a class="svc-link" asp-controller="Consultations" asp-action="Request">@SharedLocalizer["RequestConsultation"]</a>
            </article>

            <article class="svc-card">
                <span class="svc-icon svc-icon-gold">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.5 3c-1.74 0-3.41.81-4.5 2.09A5.99 5.99 0 0 0 7.5 3C4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3z"/></svg>
                </span>
                <h2 class="svc-title">@SharedLocalizer["ServiceSupportTitle"]</h2>
                <p class="svc-text">@SharedLocalizer["ServiceSupportText"]</p>
                <a class="svc-link" asp-controller="Faqs" asp-action="Index">@SharedLocalizer["Faqs"]</a>
            </article>
        </div>
    </div>
</section>
