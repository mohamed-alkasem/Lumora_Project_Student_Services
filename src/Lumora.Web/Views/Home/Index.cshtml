@model IReadOnlyList<Lumora.Application.DTOs.Universities.UniversityCardDto>
@{
    ViewData["Title"] = SharedLocalizer["Home"].Value;
    var favoriteIds = (IReadOnlySet<int>)ViewBag.FavoriteIds;
    var testimonials = (List<Lumora.Application.DTOs.Testimonials.TestimonialDto>)ViewBag.Testimonials;
}

@section Styles {
    <link rel="stylesheet" href="~/css/components/university-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}

@* ---------- Hero ---------- *@
<section class="home-hero">
    <div class="container home-hero-inner">
        <div class="home-hero-copy">
            <span class="home-hero-badge">
                <svg class="lum-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"/></svg>
                @SharedLocalizer["UniversityDirectory"] — Türkiye
            </span>
            <h1 class="home-hero-title">@SharedLocalizer["HomeHeroTitle"]</h1>
            <p class="home-hero-text">@SharedLocalizer["HomeHeroText"]</p>
            <div class="home-hero-actions">
                <a class="btn lum-btn-gold" asp-controller="Consultations" asp-action="Request">@SharedLocalizer["FreeConsultation"]</a>
                <a class="btn lum-btn-outline" asp-controller="Universities" asp-action="Index">@SharedLocalizer["BrowseUniversities"]</a>
            </div>

            <div class="home-stats">
                <div class="home-stat"><strong data-count-to="5000" data-count-suffix="+">0+</strong><span>@SharedLocalizer["StatStudents"]</span></div>
                <div class="home-stat"><strong data-count-to="120" data-count-suffix="+">0+</strong><span>@SharedLocalizer["StatUniversities"]</span></div>
                <div class="home-stat"><strong data-count-to="10" data-count-suffix="+">0+</strong><span>@SharedLocalizer["StatYears"]</span></div>
                <div class="home-stat"><strong data-count-to="98" data-count-suffix="%">0%</strong><span>@SharedLocalizer["StatAcceptance"]</span></div>
            </div>
        </div>
        <div class="home-hero-glow" aria-hidden="true"></div>
    </div>
</section>

@* ---------- Services strip ---------- *@
<section class="home-section">
    <div class="container">
        <p class="home-kicker">@SharedLocalizer["WhatWeOffer"]</p>
        <h2 class="home-section-title">@SharedLocalizer["Services"]</h2>
        <div class="home-services">
            <a class="home-service-card" data-reveal style="--reveal-delay: 0s" asp-controller="Universities" asp-action="Index">
                <span class="home-service-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3z"/></svg></span>
                <h3>@SharedLocalizer["ServiceAdmissionsTitle"]</h3>
                <p>@SharedLocalizer["ServiceAdmissionsText"]</p>
            </a>
            <a class="home-service-card" data-reveal style="--reveal-delay: 0.1s" asp-controller="Housings" asp-action="Index">
                <span class="home-service-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3 4 9v12h5v-7h6v7h5V9l-8-6z"/></svg></span>
                <h3>@SharedLocalizer["ServiceHousingTitle"]</h3>
                <p>@SharedLocalizer["ServiceHousingText"]</p>
            </a>
            <a class="home-service-card" data-reveal style="--reveal-delay: 0.2s" asp-controller="Consultations" asp-action="Request">
                <span class="home-service-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"/></svg></span>
                <h3>@SharedLocalizer["ServiceConsultingTitle"]</h3>
                <p>@SharedLocalizer["ServiceConsultingText"]</p>
            </a>
            <a class="home-service-card" data-reveal style="--reveal-delay: 0.3s" asp-controller="Services" asp-action="Index">
                <span class="home-service-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.5 3c-1.74 0-3.41.81-4.5 2.09A5.99 5.99 0 0 0 7.5 3C4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3z"/></svg></span>
                <h3>@SharedLocalizer["ServiceSupportTitle"]</h3>
                <p>@SharedLocalizer["ServiceSupportText"]</p>
            </a>
        </div>
    </div>
</section>

@* ---------- Top universities ---------- *@
<section class="home-section home-section-alt">
    <div class="container">
        <div class="home-section-head" data-reveal>
            <div>
                <p class="home-kicker">@SharedLocalizer["Universities"]</p>
                <h2 class="home-section-title">@SharedLocalizer["PublicAndPrivate"]</h2>
                <p class="home-section-sub">@SharedLocalizer["HomeUniversitiesText"]</p>
            </div>
            <a class="btn lum-btn-navy" asp-controller="Universities" asp-action="Index">@SharedLocalizer["ViewAll"]</a>
        </div>

        <div class="uni-grid home-uni-grid">
            @foreach (var card in Model)
            {
                <partial name="~/Views/Universities/_UniversityCard.cshtml"
                         model="new Lumora.Web.Models.Universities.UniversityCardViewModel(card, favoriteIds.Contains(card.Id))" />
            }
        </div>
    </div>
</section>

@* ---------- Housing blurb ---------- *@
<section class="home-section">
    <div class="container home-housing">
        <div class="home-housing-art" data-reveal="left" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 3 4 9v12h5v-7h6v7h5V9l-8-6z"/></svg>
        </div>
        <div class="home-housing-copy" data-reveal="right">
            <p class="home-kicker">@SharedLocalizer["Housing"]</p>
            <h2 class="home-section-title">@SharedLocalizer["HomeHousingTitle"]</h2>
            <p class="home-section-sub">@SharedLocalizer["HomeHousingText"]</p>
            <a class="btn lum-btn-gold" asp-controller="Housings" asp-action="Index">@SharedLocalizer["ViewAll"]</a>
        </div>
    </div>
</section>

@* ---------- Why Lumora ---------- *@
<section class="home-why">
    <div class="container">
        <p class="home-kicker home-kicker-light">@SharedLocalizer["About"]</p>
        <h2 class="home-section-title home-title-light">@SharedLocalizer["WhyLumora"]</h2>
        <p class="home-why-sub">@SharedLocalizer["WhyLumoraSub"]</p>

        <div class="home-features">
            <div class="home-feature" data-reveal="zoom" style="--reveal-delay: 0.0s">
                <span class="home-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 7a5 5 0 1 0 5 5 5 5 0 0 0-5-5zm0-2a1 1 0 0 1-1-1V2a1 1 0 0 1 2 0v2a1 1 0 0 1-1 1zm0 14a1 1 0 0 1 1 1v2a1 1 0 0 1-2 0v-2a1 1 0 0 1 1-1zm7-7a1 1 0 0 1 1-1h2a1 1 0 0 1 0 2h-2a1 1 0 0 1-1-1zM2 12a1 1 0 0 1 1-1h2a1 1 0 0 1 0 2H3a1 1 0 0 1-1-1z"/></svg></span>
                <h3>@SharedLocalizer["Feature1T"]</h3>
                <p>@SharedLocalizer["Feature1X"]</p>
            </div>
            <div class="home-feature" data-reveal="zoom" style="--reveal-delay: 0.1s">
                <span class="home-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm-8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13zm8 0c-.29 0-.62.02-.97.05A4.22 4.22 0 0 1 17 16.5V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg></span>
                <h3>@SharedLocalizer["Feature2T"]</h3>
                <p>@SharedLocalizer["Feature2X"]</p>
            </div>
            <div class="home-feature" data-reveal="zoom" style="--reveal-delay: 0.2s">
                <span class="home-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11 17H7a5 5 0 0 1 0-10h4v2H7a3 3 0 0 0 0 6h4zm2-10h4a5 5 0 0 1 0 10h-4v-2h4a3 3 0 0 0 0-6h-4zM8 11h8v2H8z"/></svg></span>
                <h3>@SharedLocalizer["Feature3T"]</h3>
                <p>@SharedLocalizer["Feature3X"]</p>
            </div>
            <div class="home-feature" data-reveal="zoom" style="--reveal-delay: 0.3s">
                <span class="home-feature-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm.5 5H11v6l5.2 3.1.8-1.3-4.5-2.7z"/></svg></span>
                <h3>@SharedLocalizer["Feature4T"]</h3>
                <p>@SharedLocalizer["Feature4X"]</p>
            </div>
        </div>
    </div>
</section>

@* ---------- How we work ---------- *@
<section class="home-section">
    <div class="container">
        <p class="home-kicker">@SharedLocalizer["SimpleSteps"]</p>
        <h2 class="home-section-title">@SharedLocalizer["HowWeWork"]</h2>

        <ol class="home-steps">
            <li class="home-step" data-reveal style="--reveal-delay: 0.0s">
                <span class="home-step-num">01</span>
                <h3>@SharedLocalizer["FreeConsultation"]</h3>
                <p>@SharedLocalizer["Step1X"]</p>
            </li>
            <li class="home-step" data-reveal style="--reveal-delay: 0.1s">
                <span class="home-step-num">02</span>
                <h3>@SharedLocalizer["Step2T"]</h3>
                <p>@SharedLocalizer["Step2X"]</p>
            </li>
            <li class="home-step" data-reveal style="--reveal-delay: 0.2s">
                <span class="home-step-num">03</span>
                <h3>@SharedLocalizer["Step3T"]</h3>
                <p>@SharedLocalizer["Step3X"]</p>
            </li>
            <li class="home-step" data-reveal style="--reveal-delay: 0.3s">
                <span class="home-step-num">04</span>
                <h3>@SharedLocalizer["Step4T"]</h3>
                <p>@SharedLocalizer["Step4X"]</p>
            </li>
            <li class="home-step" data-reveal style="--reveal-delay: 0.4s">
                <span class="home-step-num">05</span>
                <h3>@SharedLocalizer["Step5T"]</h3>
                <p>@SharedLocalizer["Step5X"]</p>
            </li>
        </ol>
    </div>
</section>

@* ---------- Testimonials ---------- *@
@if (testimonials.Count > 0)
{
    <section class="home-section home-section-alt">
        <div class="container">
            <p class="home-kicker">@SharedLocalizer["Testimonials"]</p>
            <h2 class="home-section-title">@SharedLocalizer["TestimonialsTitle"]</h2>

            <div class="home-testimonials lum-hscroll">
                @foreach (var t in testimonials)
                {
                    <figure class="home-testimonial" data-reveal="zoom">
                        <svg class="home-quote-mark" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 17h3l2-4V7H5v6h3l-2 4zm8 0h3l2-4V7h-6v6h3l-2 4z"/></svg>
                        <blockquote>@t.QuoteText</blockquote>
                        <figcaption>
                            <strong>@t.StudentName</strong>
                            <small>@t.StudentTitle</small>
                        </figcaption>
                    </figure>
                }
            </div>
        </div>
    </section>
}

@* ---------- CTA ---------- *@
<section class="home-cta" data-reveal>
    <div class="container home-cta-inner">
        <div>
            <h2 class="home-cta-title">@SharedLocalizer["ReadyTitle"]</h2>
            <p class="home-cta-text">@SharedLocalizer["ReadyText"]</p>
        </div>
        <a class="btn lum-btn-gold btn-lg" asp-controller="Consultations" asp-action="Request">@SharedLocalizer["FreeConsultation"]</a>
    </div>
</section>
