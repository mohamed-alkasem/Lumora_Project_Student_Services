@model Lumora.Web.Models.Universities.UniversityListViewModel

<div class="uni-list-root" data-total="@Model.Results.TotalCount">
    @if (Model.Results.Items.Count == 0)
    {
        <div class="uni-empty">
            <svg class="lum-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"/></svg>
            <p>@SharedLocalizer["NoResults"]</p>
        </div>
    }
    else
    {
        <div class="uni-grid">
            @foreach (var card in Model.Results.Items)
            {
                <partial name="_UniversityCard"
                         model="new Lumora.Web.Models.Universities.UniversityCardViewModel(card, Model.FavoriteIds.Contains(card.Id))" />
            }
        </div>

        @if (Model.Results.TotalPages > 1)
        {
            <nav class="uni-pagination" aria-label="Pagination">
                <button type="button" class="uni-page-btn" data-page="@(Model.Results.Page - 1)"
                        @(Model.Results.HasPrevious ? "" : "disabled")>
                    @SharedLocalizer["Previous"]
                </button>
                @for (var p = 1; p <= Model.Results.TotalPages; p++)
                {
                    <button type="button" class="uni-page-btn @(p == Model.Results.Page ? "is-active" : "")"
                            data-page="@p" @(p == Model.Results.Page ? "aria-current=page" : "")>
                        @p
                    </button>
                }
                <button type="button" class="uni-page-btn" data-page="@(Model.Results.Page + 1)"
                        @(Model.Results.HasNext ? "" : "disabled")>
                    @SharedLocalizer["Next"]
                </button>
            </nav>
        }
    }
</div>
