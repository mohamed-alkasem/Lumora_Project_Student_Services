@using Lumora.Domain.Constants
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var dir  = LanguageConstants.DirectionOf(lang);
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lumora</title>
    @if (dir == "rtl")
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <environment include="Development">
        <link rel="stylesheet" href="~/css/lumora-theme.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/shared.min.css" asp-append-version="true" />
    </environment>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @await Component.InvokeAsync("Navbar")

    <main role="main">
        @if (TempData["Success"] is string success)
        {
            <div class="container mt-3">
                <div class="alert alert-success">@success</div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="container mt-3">
                <div class="alert alert-danger">@error</div>
            </div>
        }
        @RenderBody()
    </main>

    @await Component.InvokeAsync("Footer")

    @* Floating action dock: WhatsApp (owner's number — keep in sync with footer) +
       chat + favorites. Anonymous visitors clicking chat/favorites get the login redirect. *@
    <div class="lum-float-dock">
        <a class="lum-float-btn lum-float-wa" href="https://wa.me/905359330591" target="_blank" rel="noopener"
           aria-label="WhatsApp" data-tip="WhatsApp">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.47 14.38c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.89 1.22 3.09.15.2 2.11 3.22 5.1 4.51.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.4 9.4 0 0 1-1.44-5.03c0-5.2 4.23-9.43 9.44-9.43a9.37 9.37 0 0 1 6.67 2.77 9.37 9.37 0 0 1 2.76 6.67c0 5.2-4.24 9.43-9.44 9.43zm8.03-17.46A11.29 11.29 0 0 0 12.05.75C5.8.75.72 5.83.72 12.07c0 2 .52 3.94 1.51 5.66L.63 23.55l5.96-1.56a11.32 11.32 0 0 0 5.45 1.39c6.25 0 11.33-5.08 11.33-11.32 0-3.02-1.18-5.87-3.29-8.02z"/></svg>
        </a>
        <a class="lum-float-btn lum-float-chat" asp-controller="Chat" asp-action="Index"
           aria-label="@SharedLocalizer["ChatNav"]" data-tip="@SharedLocalizer["ChatNav"]">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM7 9h10v2H7zm0-3h10v2H7zm0 6h7v2H7z"/></svg>
        </a>
        <a class="lum-float-btn lum-float-fav" asp-controller="Favorites" asp-action="Index"
           aria-label="@SharedLocalizer["MyFavorites"]" data-tip="@SharedLocalizer["MyFavorites"]">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        </a>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <environment include="Development">
        <script src="~/js/site.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/shared.min.js" asp-append-version="true"></script>
    </environment>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
