@model Lumora.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = SharedLocalizer["Login"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="container auth-wrap">
    <div class="auth-shell">
        <partial name="_AuthBrandPanel" />

        <div class="auth-form">
            <h1 class="auth-form-title">@SharedLocalizer["Login"]</h1>
            <p class="auth-form-sub">@SharedLocalizer["ChatIntro"]</p>

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">@SharedLocalizer["Email"]</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">@SharedLocalizer["Password"]</label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">@SharedLocalizer["RememberMe"]</label>
                </div>

                <button type="submit" class="btn auth-submit">@SharedLocalizer["Login"]</button>

                <p class="auth-alt">
                    @SharedLocalizer["NoAccountYet"]
                    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">@SharedLocalizer["Register"]</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/pages/auth.js" asp-append-version="true"></script>
}
